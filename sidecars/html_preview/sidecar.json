{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "HTML Preview",
  "description": "Preview HTML files directly in the side pane with one-click toggle between rendered preview (default) and source code.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "HTML Preview",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "HTML Preview",
        "file_extensions": [".html", ".htm"]
      }
    ]
  }
}
